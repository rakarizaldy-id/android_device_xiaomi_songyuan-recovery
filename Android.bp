soong_namespace {
}

cc_library_shared {
    name: "libsongyuan_memset_compat",
    srcs: ["compat/songyuan_memset_compat.c"],
    compile_multilib: "64",
    recovery: true,
    stl: "none",
    cflags: [
        "-fno-builtin",
        "-fno-vectorize",
        "-fno-slp-vectorize",
        "-fno-unroll-loops",
    ],
}
