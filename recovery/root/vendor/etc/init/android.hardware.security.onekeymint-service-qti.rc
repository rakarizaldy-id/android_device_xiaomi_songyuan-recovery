# Stock ID305 QTI KeyMint executable; restore original system UID/GID.
# Recovery seclabel remains explicit; compiled policy compatibility still unproven.
on init
    start vendor.keymint

service vendor.keymint /vendor/bin/hw/android.hardware.security.onekeymint-service-qti
    class early_hal
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
