service recovery.songyuan-security-setup /system/bin/sh /system/bin/songyuan-security-setup.sh
    class core
    disabled
    oneshot
    user root
    group root system
    seclabel u:r:recovery:s0

on property:init.svc.vendor.minkdaemon=running && property:recovery.songyuan.security_firmware_ready=1
    start recovery.songyuan-weaver-start

service recovery.songyuan-weaver-start /system/bin/sh /system/bin/songyuan-weaver-start.sh
    class core
    disabled
    oneshot
    user root
    group root system
    seclabel u:r:recovery:s0
