on property:init.svc.vendor.qseecomd=running
    start recovery.songyuan-security-setup

service recovery.songyuan-security-setup /system/bin/songyuan-security-setup.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:init.svc.vendor.minkdaemon=running
    start recovery.songyuan-weaver-start

service recovery.songyuan-weaver-start /system/bin/songyuan-weaver-start.sh
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0
