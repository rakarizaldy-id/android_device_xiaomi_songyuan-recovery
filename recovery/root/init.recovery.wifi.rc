# Portable EkinStrop recovery WLAN startup control. Genuine Songyuan
# vendor Wi-Fi daemons are NOT packaged yet; never declare a missing HAL.
# Mounting the stock partitions hides recovery's ramdisk crypto helpers, so
# keep WLAN behind the completed decryption preparation chain.
on property:twrp.super.symlinks_created=true && property:recovery.songyuan.security_firmware_ready=1 && property:crypto.ready=1
    start songyuan-wlan-setup

service songyuan-wlan-setup /system/bin/songyuan-wlan-setup.sh
    user root
    group root system inet net_admin wifi
    capabilities CHOWN DAC_OVERRIDE FOWNER SYS_ADMIN SYS_MODULE NET_ADMIN NET_RAW
    disabled
    oneshot
    seclabel u:r:recovery:s0

service songyuan-wlan-autostart /system/bin/songyuan-wlan-control.sh start
    user root
    group root system inet net_admin wifi
    capabilities CHOWN DAC_OVERRIDE FOWNER NET_ADMIN NET_RAW
    disabled
    oneshot
    seclabel u:r:recovery:s0

service songyuan-wlan-monitor /system/bin/songyuan-wlan-control.sh monitor
    user root
    group root system inet net_admin wifi
    capabilities NET_ADMIN NET_RAW
    disabled
    oneshot
    seclabel u:r:recovery:s0
