service weaver_hal_service /odm/bin/hw/android.hardware.weaver-service.thales
    class hal
    disabled
    oneshot
    interface aidl android.hardware.weaver.IWeaver/default
    user 2916
    group 2916 system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0

on property:ro.special_edition=true
    stop weaver_hal_service
