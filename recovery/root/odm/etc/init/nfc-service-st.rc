# Original ID305 ST NFC service RC has only INfc/default.
# eSE1 belongs in the stock ODM VINTF, not as an invented init interface.
service nfc_hal_service /odm/bin/hw/android.hardware.nfc-service-st
    class hal
    user nfc
    group nfc
    interface aidl android.hardware.nfc.INfc/default
    disabled
    oneshot
    seclabel u:r:recovery:s0
