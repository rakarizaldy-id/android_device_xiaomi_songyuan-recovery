# Genuine Songyuan ID305 MiAuthSecret and OldCredential AIDL.
service miweaver_hal_service /odm/bin/hw/vendor.xiaomi.hardware.authsecretd
    class hal
    disabled
    oneshot
    user system
    group system drmrpc
    interface aidl vendor.xiaomi.hardware.miauthsecretd.IMIAuthSecret/default
    interface aidl vendor.xiaomi.hardware.miauthsecretd.ICpaceService/default
    interface aidl vendor.xiaomi.hardware.oldcredential.IOldCredentialService/default
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
