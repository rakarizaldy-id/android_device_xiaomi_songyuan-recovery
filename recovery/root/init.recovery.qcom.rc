on init
    setprop sys.usb.configfs 1
    setprop prepdecrypt.setpatch true

on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start recovery.songyuan-crypto-timeout

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}

on property:servicemanager.ready=true
    start vendor.boot-default

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mkdir /mnt/vendor 0775 shell system
    mkdir /persist 0771 root system
    mount ext4 /dev/block/bootdevice/by-name/persist /persist nosuid nodev barrier=1
    symlink /persist /mnt/vendor/persist

on property:twrp.modules.loaded=true && property:init.svc.adbd=running
    start songyuan-touch-init

service songyuan-touch-init /system/bin/sh /system/bin/songyuan-touch-init.sh
    class core
    disabled
    oneshot
    user root
    group root system input
    seclabel u:r:recovery:s0

service recovery.songyuan-crypto-timeout /system/bin/sh -c "sleep 30; setprop ctl.start odm.prepdecrypt"
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
