on init
    setprop sys.usb.configfs 1
    setprop prepdecrypt.setpatch true

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    wait /dev/block/bootdevice/by-name/ssd 10
    mkdir /vendor/firmware_mnt 0755 root root
    mkdir /vendor/modem_firmware 0755 root root
    mkdir /vendor/dsp 0755 root root
    wait /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} 10
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro
    wait /dev/block/bootdevice/by-name/modemfirmware${ro.boot.slot_suffix} 10
    mount vfat /dev/block/bootdevice/by-name/modemfirmware${ro.boot.slot_suffix} /vendor/modem_firmware ro
    wait /dev/block/bootdevice/by-name/dsp${ro.boot.slot_suffix} 10
    mount ext4 /dev/block/bootdevice/by-name/dsp${ro.boot.slot_suffix} /vendor/dsp ro nosuid nodev
    start vendor.qseecomd

on boot
    setprop sys.usb.config adb

on property:twrp.modules.loaded=true && property:init.svc.adbd=running
    start songyuan-touch-init

on property:init.svc.vendor.qseecomd=running
    start recovery.songyuan-security-setup

service songyuan-touch-init /system/bin/sh /system/bin/songyuan-touch-init.sh
    class core
    disabled
    oneshot
    user root
    group root system input
    seclabel u:r:recovery:s0
